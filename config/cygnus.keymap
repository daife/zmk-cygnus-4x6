#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt2 {
            bindings = <&tog 4>;
            key-positions = <48 53>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8  |  9  |  0  |  ?   |
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&hmr CAPSLOCK ESC  &kp N1  &kp N2  &kp N3          &kp N4        &kp N5       &kp N6       &kp N7         &kp N8      &kp N9   &kp N0     &kp BSPC
&kp TAB            &kp Q   &kp W   &kp E           &kp R         &kp T        &kp Y        &kp U          &kp I       &kp O    &kp P      &kp ENTER
&sk LEFT_SHIFT     &kp A   &kp S   &kp D           &kp F         &kp G        &kp H        &kp J          &kp K       &kp L    &kp SEMI   &kp SQT
&kp LEFT_CONTROL   &kp Z   &kp X   &kp C           &kp V         &kp B        &kp N        &kp M          &kp COMMA   &kp DOT  &kp SLASH  &kp RIGHT_SHIFT
                                   &lt 1 LEFT_GUI  &kp LEFT_ALT  &kp SPACE    &lt 2 SPACE  &kp BACKSPACE  &kp RETURN
            >;
        };

        layer_2 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&hmr LC(LS(ESCAPE)) ESCAPE  &kp F1     &kp F2                &kp F3                &kp F4                &kp F5           &kp F6         &kp F7    &kp F8         &kp F9     &kp F10        &kp F11
&hmr TILDE GRAVE            &kp EXCL   &kp AT                &kp HASH              &hmr LG(R) DLLR       &kp PRCNT        &kp CARET      &kp AMPS  &kp ASTRK      &kp LPAR   &kp RPAR       &kp F12
&trans                      &kp LC(A)  &hmr LG(LS(S)) LC(S)  &hmr LG(D) LC(D)      &hmr LC(LS(S)) LC(F)  &kp LG(DOT)      &kp PG_UP      &kp DEL   &kp UP         &kp LG(L)  &none          &none
&trans                      &kp LC(Z)  &hmr LG(X) LC(X)      &hmr LC(LS(C)) LC(C)  &hmr LG(V) LC(V)      &sl 3            &kp PAGE_DOWN  &kp LEFT  &kp DOWN       &kp RIGHT  &kp LC(SLASH)  &trans
                                                             &trans                &trans                &kp LG(SPACE)    &kp LG(SPACE)  &trans    &kp LS(ENTER)
            >;
        };

        layer_1 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 | BKSP |
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans            &kp F1        &kp F2        &kp F3        &kp F4        &kp F5       &kp F6         &kp F7            &kp F8             &kp F9         &kp F10  &kp F11
&hmr TILDE GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &kp N6         &kp N7            &kp N8             &kp N9         &kp N0   &kp F12
&trans            &trans        &trans        &trans        &trans        &trans       &kp RC(RS(H))  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &none    &none
&trans            &trans        &trans        &trans        &trans        &trans       &none          &kp MINUS         &kp EQUAL          &none          &none    &trans
                                              &trans        &trans        &kp SPACE    &trans         &trans            &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N7  &kp N8  &kp N9  &kp N0  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        bluetooth {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans        &trans  &trans        &trans  &trans  &trans
            >;
        };
    };
};
